# web/.env.local의 예시. 값은 비워 두었다. 비밀 값은 web/.env.local에만 두고 커밋하지 않는다(README "환경 변수").

# Claude API(판정, 카드 생성)
ANTHROPIC_API_KEY=

# 개발 DB(Neon dev 브랜치). 개발 서버와 --dev 명령이 쓴다. 풀링 주소와 풀링하지 않는 주소
DATABASE_URL=
DATABASE_URL_UNPOOLED=
# 운영 DB(Neon production 브랜치). 관리 명령(백업, 마이그레이션, 카드 생성, 이전)이 쓴다
PROD_DATABASE_URL=
PROD_DATABASE_URL_UNPOOLED=

# Neon API(개발 DB 초기화, 테스트 브랜치)
NEON_API_KEY=
NEON_PROJECT_ID=
NEON_DEV_BRANCH_ID=
NEON_PROD_BRANCH_ID=

# 구글 로그인(OAuth 클라이언트)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 관리자 구글 계정 이메일
ADMIN_EMAIL=
