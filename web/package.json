{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "TZ=UTC tsx --test $(find src -name \"*.test.ts\" ! -name \"*.int.test.ts\")",
    "test:integration": "TEST_DATABASE_URL=$(tsx test/setup-db.ts) TZ=UTC tsx --test --experimental-test-module-mocks --test-concurrency=1 $(find src test -name \"*.int.test.ts\")",
    "check": "npm run typecheck && npm run lint && npm test",
    "verify": "npm run check && npm run build",
    "check:repo": "tsx scripts/checks/repo-check.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "prepare": "cd .. && (git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true)",
    "db:backup": "tsx scripts/backup.ts",
    "db:dev-reset": "tsx scripts/dev-reset.ts",
    "db:import-local": "tsx scripts/import-local.ts",
    "db:reset-progress": "tsx scripts/reset-progress.ts",
    "cards:generate": "tsx scripts/generate-cards.ts",
    "test:e2e": "tsx test/e2e/run.ts",
    "deploy": "tsx scripts/deploy.ts",
    "smoke": "tsx scripts/smoke.ts",
    "check:output": "tsx scripts/checks/output-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@vercel/analytics": "^2.0.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
